---
import { sitePath } from '../lib/site';
import ArticleOutline from './ArticleOutline.astro';
import { outlines } from '../lib/outlines';
import { chapterLabel, type NavigationSection } from '../lib/navigation';

interface Props {
  navigation: NavigationSection[];
  section?: string;
  currentPath: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { navigation, section, currentPath } = Astro.props;
---
<div class="app-name">
  <a class="app-name-link" href={sitePath("/")} aria-label="Agent Dev Foundations 首页">
    <svg class="brand-mark" viewBox="0 0 64 64" width="44" height="44" fill="currentColor" aria-hidden="true">
      <path d="M7 53 27 11h10L17 53Zm29-32 21 32H43L30 33Z" />
      <path fill="#7c5cfc" d="M23 45h13l5 8H19Z" />
    </svg>
    <span class="brand-wordmark"><span class="brand-name">Agent Dev</span><span class="brand-foundations">Foundations</span></span>
  </a>
</div>
<div class="search">
  <div class="input-wrap">
    <input data-search type="search" aria-label="搜索文档" placeholder="搜索文档..." autocomplete="off" />
    <button class="clear-button" type="button" aria-label="清空搜索" hidden>
      <svg width="26" height="24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#ccc" /><path stroke="white" stroke-width="2" d="M8.25,8.25,15.75,15.75" /><path stroke="white" stroke-width="2" d="M8.25,15.75,15.75,8.25" /></svg>
    </button>
  </div>
  <div class="results-panel" hidden></div>
</div>
<nav class="sidebar-nav" aria-label="章节目录">
  <ul>
    <li class:list={{ active: currentPath === '/' }}><p><a href={sitePath("/")} title="首页" aria-current={currentPath === '/' ? 'page' : undefined}>首页</a></p></li>
    {navigation.map(item => {
      const expanded = item.id === section;
      let chapterNumber = 0;
      return <li class:list={['nav-section', { 'section-current': expanded }]} data-section={item.id}>
        <p><a href={sitePath(item.href)} title={item.label} data-section-toggle={expanded ? '' : undefined} aria-current={currentPath === item.href ? 'page' : undefined} aria-expanded={expanded}>{item.label}</a></p>
        {expanded && <ul class="section-children">
          {item.groups.map(group => <li>
            <p><strong>{group.label}</strong></p>
            <ul>
              {group.items.map(chapter => {
                const current = chapter.href === currentPath;
                const outline = outlines.get(chapter.href) ?? [];
                return <li class:list={['chapter-item', { active: current, 'outline-collapsed': !current }]}>
                  <a href={sitePath(chapter.href)} title={chapter.title} aria-current={current ? 'page' : undefined}>{++chapterNumber}. {chapterLabel(chapter.title)}</a>
                  {outline.length > 0 && <button class="chapter-toggle" type="button" aria-label={`${chapterLabel(chapter.title)}的小节目录`} aria-expanded={current}><span aria-hidden="true" /></button>}
                  <ArticleOutline headings={outline} href={current ? '' : sitePath(chapter.href)} />
                </li>;
              })}
            </ul>
          </li>)}
        </ul>}
      </li>;
    })}
  </ul>
</nav>
