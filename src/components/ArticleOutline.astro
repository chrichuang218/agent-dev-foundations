---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  href?: string;
}
const { headings, href = '' } = Astro.props;
---
{headings.length > 0 && <ul class="app-sub-sidebar" aria-label="章节小节">{headings.map(heading => <li><a class="section-link" href={`${href}#${heading.slug}`} title={heading.text}>{heading.text}</a></li>)}</ul>}
