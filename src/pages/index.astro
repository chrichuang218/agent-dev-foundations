---
import { sitePath } from '../lib/site';
import GuideLayout from '../layouts/GuideLayout.astro';
import { navigation } from '../lib/content';
const logos = ['html5.svg', 'javascript.svg', null, 'typescript.svg'];
const labels = ['STRUCTURE', 'RUNTIME', 'MODERN JAVASCRIPT', 'TYPE SYSTEM'];
const cards = [
  ...navigation.map((section, i) => ({ ...section, href: sitePath(section.href), logo: logos[i], caption: labels[i] })),
  { id: 'react', label: 'React', href: 'https://zh-hans.react.dev/learn', logo: 'react.svg', caption: 'USER INTERFACE', description: '构建交互界面。从组件与事件，到状态管理与 Hooks。' },
  { id: 'nextjs', label: 'Next.js', href: undefined, logo: 'nextjs.svg', caption: 'FULL STACK', description: '基于 React 的应用框架。路由、服务端渲染与数据获取。' },
  { id: 'nodejs', label: 'Node.js', href: undefined, logo: 'nodejs.svg', caption: 'SERVER SIDE', description: '在服务端运行 JavaScript。文件、进程、网络与异步任务。' },
  { id: 'python', label: 'Python', href: undefined, logo: 'python.svg', caption: 'LANGUAGE', description: '从脚本自动化到 AI 应用。语言基础、数据处理与工具集成。' },
];
---
<GuideLayout title="Agent Dev Foundations" description="面向后端程序员的 Agent 开发基础知识，涵盖 HTML、JavaScript、ES6、TypeScript 与项目配置。" currentPath="/" navigation={navigation} headings={[{depth:2,slug:'browse',text:'浏览知识目录'}]}>
<div class="home">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <h1 id="home-title">打好基础，<br/>驾驭 Agent。</h1>
      <p class="intro">从语言、框架到工程实践，积累 Agent 开发所需的基础知识。</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      {['nextjs.svg','html5.svg','react.svg','A','ES6','javascript.svg','nodejs.svg','typescript.svg','python.svg'].map((label,i)=><span class={`orb orb-${i}`} style={`--i:${i}`}>
        {label==='A'?<svg viewBox="0 0 64 64"><path fill="currentColor" d="M7 53 27 11h10L17 53Zm29-32 21 32H43L30 33Z"/><path fill="#b6a4ff" d="M23 45h13l5 8H19Z"/></svg>:label.endsWith('.svg')?<img class="orb-logo" src={sitePath(`/media/languages/${label}`)} width="24" height="24" alt=""/>:label==='ES6'?<span class="orb-es6">ES6</span>:null}
      </span>)}
    </div>
  </section>
  <section aria-labelledby="browse">
    <h2 id="browse">知识目录</h2>
    <div class="subject-grid">
      {cards.map((section,i)=>{ const Tag = section.href ? 'a' : 'div'; return <Tag class={`subject-card subject-${section.id}`} href={section.href}>
        <div class="preview" aria-hidden="true"><span class="caption">{section.caption}</span>{section.logo ? <img class="language-logo" src={sitePath(`/media/languages/${section.logo}`)} width="72" height="72" alt="" /> : <span class="language-logo es6-mark">ES6</span>}<span class="caption">0{i+1} / FOUNDATIONS</span></div>
        <div class="card-copy"><h3>{section.label}</h3><p>{section.description}</p></div>
      </Tag>; })}
    </div>
  </section>
</div>
</GuideLayout>
<style>
:global(.markdown-section:has(.home)){max-width:1220px;padding:40px 48px 32px}
.home{--surface:#fbfaff;--line:#e9e7ef;--muted:#727381;color:var(--heading-color)}

.hero{display:flex;align-items:center;gap:24px;min-height:190px;padding:0 0 24px}
.hero-copy{flex:1 0 51%}
.home h1{font-size:clamp(36px,3.5vw,46px);line-height:1.22;letter-spacing:-.045em;font-weight:700;margin:0}
.home .intro{font-size:16px;line-height:1.8;color:var(--muted);margin:16px 0 0}
.home a{text-decoration:none}

.hero-art{display:flex;align-items:center;flex:1;min-width:0;padding:15px 0}
.orb{display:grid;place-items:center;position:relative;flex:1 0 0;aspect-ratio:1;border-radius:50%;margin-left:-8px;color:white;font:600 18px/1 Consolas,monospace;box-shadow:inset 2px 2px 5px #ffffff55,0 14px 28px #231b4410;animation:drift 6s ease-in-out infinite alternate;animation-delay:calc(var(--i) * -.8s)}
.orb:first-child{margin-left:0}.orb svg{width:75%}
.orb-logo{display:block;width:58%;height:58%;object-fit:contain}
.orb-es6{display:flex;align-items:flex-end;justify-content:flex-end;width:58%;height:58%;padding:2px;background:#f7df1e;color:#191919;font:700 9px/1 Arial,sans-serif;letter-spacing:-.4px}
.orb-0{background:#d7d4e7}.orb-1{background:#c0b6ec;margin-bottom:26px}.orb-2{background:#9b87db;margin-bottom:48px}.orb-3{background:#2e293d;margin-bottom:28px;flex-grow:1.5;z-index:1}.orb-4{background:#7c5cfc}.orb-5{background:#bcb1ed;margin-top:30px}.orb-6{background:#ddd6f5;margin-top:52px}.orb-7{background:#8171b3;margin-top:26px}.orb-8{background:#d3ccea}
@keyframes drift{from{transform:translateY(-5px)}to{transform:translateY(5px)}}

.home h2{font-size:26px;line-height:1.4;letter-spacing:-.035em;margin:0 0 24px}
.subject-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.subject-card{display:flex;flex-direction:column;min-width:0;padding:12px;border-radius:22px;border:1px solid var(--line);background:var(--surface);color:var(--heading-color);box-shadow:0 12px 32px #231b4405;transition:transform .2s ease,box-shadow .2s ease}
a.subject-card:hover{transform:translateY(-4px);box-shadow:0 16px 32px #231b4410}
.preview{display:flex;flex-direction:column;justify-content:space-between;height:155px;padding:16px;border-radius:13px;overflow:hidden;background:#eee9e1;color:#6d5a48}
.subject-javascript .preview{background:#f0edcf;color:#6b602e}.subject-es6 .preview{background:#e6e0f4;color:#6a519e}.subject-typescript .preview{background:#dae7ef;color:#375d7a}
.subject-react .preview{background:#dceef2;color:#365f6b}.subject-nextjs .preview{background:#e7e7eb;color:#50505c}.subject-nodejs .preview{background:#e0ebda;color:#48613b}.subject-python .preview{background:#e7e9de;color:#596047}
.language-logo{display:block;align-self:center;width:72px;height:72px;object-fit:contain}
.es6-mark{display:flex;align-items:flex-end;justify-content:flex-end;padding:7px;background:#f7df1e;color:#191919;font:700 26px/1 Arial,sans-serif;letter-spacing:-1px}
.caption{font:9px/1.3 Consolas,monospace;letter-spacing:.05em;opacity:.75}
.card-copy{padding:18px 6px 12px;flex:1}.home h3{font-size:20px;line-height:1.4;margin:0 0 10px;letter-spacing:-.025em}
.home .card-copy p{font-size:13px;line-height:1.75;color:var(--muted);margin:0}

:global([data-theme="dark"]) .home{--surface:#202130;--line:#333447;--muted:#a7a8ba}
/* Subjects without site content yet are shown faded and grayscale. */
div.subject-card{opacity:.55;box-shadow:none}div.subject-card .preview{filter:grayscale(1)}
@media(max-width:1200px){.subject-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-art{max-width:300px}.orb{font-size:13px;margin-left:-6px}}
@media(max-width:767px){:global(.markdown-section:has(.home)){padding:80px 20px 30px}.hero{display:block;padding:0 0 32px;min-height:0}.hero-art{display:none}.home h1{font-size:40px}.home .intro{font-size:14px}.home h2{font-size:23px;margin-bottom:16px}
  /* One row per subject keeps all eight entries within about a screen and a half. */
  .subject-grid{grid-template-columns:1fr;gap:10px}.subject-card{flex-direction:row;align-items:center;gap:14px;padding:8px;border-radius:16px}
  .preview{flex:none;justify-content:center;width:76px;height:76px;padding:0;border-radius:11px}.caption{display:none}.language-logo{width:44px;height:44px}.es6-mark{padding:4px;font-size:16px;letter-spacing:-.5px}
  .card-copy{padding:2px 6px 2px 0}.home h3{font-size:17px;margin:0 0 4px}.home .card-copy p{font-size:13px;line-height:1.6}}
@media(prefers-reduced-motion:reduce){.orb{animation:none}.subject-card{transition:none}a.subject-card:hover{transform:none}}
</style>
