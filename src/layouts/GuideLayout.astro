---
import { sitePath, repositoryUrl } from '../lib/site';
import globalStyles from '../styles/global.css?url';
import readingTrial from '../styles/reading-trial.css?url';
import SidebarNav from '../components/SidebarNav.astro';
import Pagination from '../components/Pagination.astro';
import ArticleOutline from '../components/ArticleOutline.astro';
import { outlines } from '../lib/outlines';
import type { ChapterLink, NavigationSection } from '../lib/navigation';
import type { Section } from '../lib/content';
interface Props {
  title: string;
  description?: string;
  section?: Section;
  currentPath: string;
  navigation: NavigationSection[];
  headings?: { depth: number; slug: string; text: string }[];
  previous?: ChapterLink;
  next?: ChapterLink;
}
const {
  title, description = '面向后端程序员的 Agent 开发基础知识，涵盖 HTML、JavaScript、ES6、TypeScript 与项目配置。',
  section, currentPath, navigation, headings = [], previous, next,
} = Astro.props;
const pageTitle = title === 'Agent Dev Foundations' ? title : `${title} · Agent Dev Foundations`;
const pageOutline = outlines.get(currentPath) ?? [];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7c5cfc" />
    {import.meta.env.BASE_URL === "/" && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <link rel="license" href={sitePath("/about/")} />
    <script is:inline>
      // A saved choice wins; otherwise follow the system color scheme.
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch {}
      document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved
        : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
    <link rel="stylesheet" href={sitePath("/styles/reference-theme.css")} />
    <link rel="stylesheet" href={sitePath("/styles/reference-shell.css")} />
    <link rel="stylesheet" href={sitePath("/styles/reference-pagination.css")} />
    <link rel="stylesheet" href={globalStyles} />
    <link rel="stylesheet" href={readingTrial} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={['ready sticky', { 'has-page-toc': pageOutline.length > 1 }]}>
    <a href={repositoryUrl} target="_blank" rel="noopener noreferrer" class="github-corner" aria-label="查看 GitHub 仓库"><svg viewBox="0 0 250 250" aria-hidden="true"><path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path><path d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" fill="currentColor" style="transform-origin: 130px 106px;" class="octo-arm"></path><path d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" fill="currentColor" class="octo-body"></path></svg></a>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <main>
    <button class="sidebar-toggle" type="button" aria-label="切换目录" aria-controls="desktop-sidebar" aria-expanded="true">
      <div class="sidebar-toggle-button" aria-hidden="true"><span></span><span></span><span></span></div>
    </button>
    <aside class="sidebar desktop-sidebar" id="desktop-sidebar" aria-label="章节目录">
      <SidebarNav {navigation} {section} {currentPath} {headings} />
      {/* Inside the aside so `.sidebar + .content` in the theme still matches. */}
      <script is:inline>
      // Restore the sidebar position before first paint so switching chapters does not jump.
      // Keep the key in sync with sidebarScrollKey in reader.ts.
      (() => {
        const sidebar = document.getElementById('desktop-sidebar');
        if (!sidebar || matchMedia('(max-width: 767px)').matches) return;
        const section = sidebar.querySelector('.section-current[data-section]')?.dataset.section ?? 'index';
        const key = `typescript-guide:sidebar:${section}:desktop-sidebar`;
        try {
          const saved = Number(sessionStorage.getItem(key));
          if (saved > 0) sidebar.scrollTop = saved;
          // Outlines above may have collapsed; keep the clicked chapter where it was clicked.
          const anchor = sessionStorage.getItem('typescript-guide:sidebar-anchor');
          sessionStorage.removeItem('typescript-guide:sidebar-anchor');
          const current = sidebar.querySelector('.chapter-item > a[aria-current="page"]');
          if (anchor !== null && current) {
            sidebar.scrollTop += current.getBoundingClientRect().top - sidebar.getBoundingClientRect().top - Number(anchor);
            sessionStorage.setItem(key, String(sidebar.scrollTop));
          }
        } catch {}
      })();
      </script>
    </aside>
    <section class="content">
      <article id="main-content" class="markdown-section" tabindex="-1">
        <slot />
        <Pagination {previous} {next} {navigation} {section} />
      </article>
    </section>
    {pageOutline.length > 1 && <nav class="page-toc" aria-label="本页目录">
      <p class="page-toc-title">本页目录</p>
      <ArticleOutline headings={pageOutline} />
    </nav>}
    </main>
    <div class="top-btn-group"><button id="dark-toggle" class="dark-toggle-btn" type="button" aria-label="切换深色模式" aria-pressed="false" title="切换深色模式"><svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"/></svg><svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button></div>
    <script src="../scripts/reader.ts"></script>
  </body>
</html>
